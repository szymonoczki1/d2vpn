<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WinDivert exposes packet headers as raw pointers; reading them requires unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WindivertDotnet" Version="1.1.2" />
  </ItemGroup>


  <ItemGroup>
    <!-- Packet parsing is internal because nothing outside this assembly should be handed raw
         WinDivert structures, but it is also where a silent misreading of a header would do the
         most damage - so the tests reach it directly. -->
    <InternalsVisibleTo Include="D2Vpn.Core.Tests" />
  </ItemGroup>

</Project>
