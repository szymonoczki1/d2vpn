<Application x:Class="D2Vpn.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:D2Vpn.Ui"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Palette.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
                <ResourceDictionary Source="Theme/ScrollBar.xaml" />
                <ResourceDictionary Source="Theme/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <ui:NullToVisibilityConverter x:Key="NullToVisibility" />
            <ui:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
            <ui:BoolToOpacityConverter x:Key="BoolToOpacity" />
            <ui:KeyToGeometryConverter x:Key="KeyToGeometry" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
