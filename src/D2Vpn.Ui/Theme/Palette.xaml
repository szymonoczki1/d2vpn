<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark blue through black. Surfaces step up in lightness as they come forward - window,
        sidebar, panel, card - so depth reads without borders doing the work. The accent is the
        only saturated colour, which is what makes an active module obvious at a glance.
    -->

    <!-- Surfaces, furthest back to furthest forward. -->
    <Color x:Key="WindowColor">#FF070A12</Color>
    <Color x:Key="SidebarColor">#FF0B1020</Color>
    <Color x:Key="PanelColor">#FF101832</Color>
    <Color x:Key="CardColor">#FF16204A</Color>
    <Color x:Key="HoverColor">#FF1C2A5C</Color>

    <!-- Accent: the blue everything interactive is keyed to. -->
    <Color x:Key="AccentColor">#FF3D7BFF</Color>
    <Color x:Key="AccentDimColor">#FF24498F</Color>

    <!-- State. Red is reserved for holding, because a hold is the thing you must not forget. -->
    <Color x:Key="HoldingColor">#FFFF5470</Color>
    <Color x:Key="OkColor">#FF3DD68C</Color>
    <Color x:Key="WarnColor">#FFFFB454</Color>

    <!-- Text, in descending prominence. -->
    <Color x:Key="TextColor">#FFE8EDFB</Color>
    <Color x:Key="TextDimColor">#FF93A0C4</Color>
    <Color x:Key="TextFaintColor">#FF5C6A91</Color>

    <Color x:Key="LineColor">#FF1E2A50</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="HoldingBrush" Color="{StaticResource HoldingColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />

</ResourceDictionary>
