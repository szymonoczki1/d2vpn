<Window x:Class="D2Vpn.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:D2Vpn.Ui.ViewModels"
        Title="d2vpn"
        Height="660" Width="1000"
        MinHeight="540" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize">

    <!--
        WindowStyle="None" removes the system caption bar so the window can be drawn end to end in
        its own palette. WindowChrome keeps what the system bar was actually providing - the resize
        borders, snapping, and Aero Snap - which a bare borderless window loses.
    -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ModuleViewModel}">
            <StackPanel>

                <!-- Header. The enable switch sits here because it governs everything below
                     it: a disabled module shows its settings but will not act on them. -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Subtle}" />
                            <TextBlock Text="  ·  " Style="{StaticResource Subtle}" />
                            <TextBlock Text="{Binding StateLabel}"
                                       Style="{StaticResource Subtle}" FontWeight="SemiBold" />
                            <TextBlock Text="  ·  " Style="{StaticResource Subtle}"
                                       Visibility="{Binding IsTiming,
                                          Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding HeldLabel}"
                                       Style="{StaticResource Subtle}" FontWeight="SemiBold"
                                       Foreground="{StaticResource HoldingBrush}"
                                       Visibility="{Binding IsTiming,
                                          Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource Switch}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              Content="Module enabled" />
                </Grid>

                <!-- The on switch. Everything but a reconnect has one, including pause. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding IsToggleable,
                           Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding ToggleSectionLabel}" Style="{StaticResource SectionLabel}" />
                            <TextBlock Style="{StaticResource Subtle}"
                                       Text="{Binding ToggleDescription}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <!-- Counting up while it runs, because "how long have I been
                                 holding this" is the question a hold creates. -->
                            <TextBlock Text="{Binding HeldLabel}"
                                       FontSize="22" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,18,0"
                                       Foreground="{StaticResource HoldingBrush}"
                                       Visibility="{Binding IsTiming,
                                          Converter={StaticResource BoolToVisibility}}" />

                            <CheckBox Style="{StaticResource Switch}"
                                      VerticalAlignment="Center"
                                      IsEnabled="{Binding CanHold}"
                                      IsChecked="{Binding IsActive, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Reconnect, for a trigger. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding IsTrigger,
                           Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="RECONNECT" Style="{StaticResource SectionLabel}" />
                        <TextBlock Style="{StaticResource Subtle}"
                                   Text="Injects a TCP reset into every live connection on this group - one to the peer, one to this machine, since killing one end leaves the other believing the connection is alive. The game error-codes and reconnects by itself." />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                   Text="A connection can only be reset once a packet carrying payload has been seen in both directions, so give it a few seconds of traffic first." />
                        <Button Content="Reconnect now"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsEnabled}"
                                Margin="0,14,0,0"
                                Click="OnReset" />
                    </StackPanel>
                </Border>

                <!-- Keys. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="KEYS" Style="{StaticResource SectionLabel}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding KeyActionLabel}"
                                       VerticalAlignment="Center" Margin="0,7" />
                            <Button Grid.Column="1" Margin="0,4"
                                    Style="{StaticResource KeyButton}"
                                    Content="{Binding BindLabel}"
                                    Tag="Toggle" Click="OnRebind" />

                            <TextBlock Grid.Row="1" Text="Autoresync"
                                       VerticalAlignment="Center" Margin="0,7"
                                       Visibility="{Binding SupportsResync,
                                          Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Row="1" Grid.Column="1" Margin="0,4"
                                    Style="{StaticResource KeyButton}"
                                    Content="{Binding ResyncKeyLabel}"
                                    Tag="Resync" Click="OnRebind"
                                    Visibility="{Binding SupportsResync,
                                       Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Row="2" Text="Buffer"
                                       VerticalAlignment="Center" Margin="0,7"
                                       Visibility="{Binding SupportsBuffer,
                                          Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Row="2" Grid.Column="1" Margin="0,4"
                                    Style="{StaticResource KeyButton}"
                                    Content="{Binding BufferKeyLabel}"
                                    Tag="Buffer" Click="OnRebind"
                                    Visibility="{Binding SupportsBuffer,
                                       Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,12,0,0"
                                   Text="Click a key, then press one. Esc clears it, so a module can be driven from this window alone." />
                    </StackPanel>
                </Border>

                <!-- Switches. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasSwitches,
                           Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="SWITCHES" Style="{StaticResource SectionLabel}" />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,4"
                                  IsChecked="{Binding ResyncEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding SupportsResync}"
                                  Content="Autoresync"
                                  Visibility="{Binding SupportsResync,
                                     Converter={StaticResource BoolToVisibility}}" />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,8,0,4"
                                  IsChecked="{Binding BufferEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding SupportsBuffer}"
                                  Content="Buffer withheld packets"
                                  Visibility="{Binding SupportsBuffer,
                                     Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,12,0,0"
                                   Text="Both take effect on the next packet. A delay line cannot give up its buffer, since a packet cannot arrive late unless it was kept." />
                    </StackPanel>
                </Border>

                <!-- The macro, which only the macro module has. Kept beside its switch rather
                     than on a Settings page: these are what you change while tuning a swap that is
                     not working, and walking to another page between attempts loses the thread. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding IsMacro, Converter={StaticResource BoolToVisibility}}"
                        DataContext="{Binding Macro}">
                    <StackPanel>
                        <TextBlock Text="ROTATION" Style="{StaticResource SectionLabel}" />

                        <!-- An explicit ItemTemplate rather than DisplayMemberPath: that one
                             leaves SelectionBoxItemTemplate null, so the closed dropdown rendered
                             the record's ToString while the open list looked right. -->
                        <ComboBox Style="{StaticResource Dropdown}"
                                  ItemsSource="{Binding Presets}"
                                  SelectedIndex="{Binding SelectedPreset, Mode=TwoWay}"
                                  Margin="0,2,0,0"
                                  HorizontalAlignment="Left" MinWidth="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Name" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Padding="10,7"
                                     Background="{StaticResource CardBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource LineBrush}"
                                     BorderThickness="1"
                                     Text="{Binding PresetName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Grid.Row="1" Text="Order"
                                       VerticalAlignment="Center" Margin="0,10,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Padding="10,7" Margin="0,10,0,0"
                                     Background="{StaticResource CardBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource LineBrush}"
                                     BorderThickness="1"
                                     FontFamily="{StaticResource MonoFont}"
                                     Text="{Binding OrderText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                   Text="Loadout numbers in the order they are clicked, repeating until the duration is up. Slot 1 is top left, 4 is the end of the first row, 5 is below 1. A number may appear more than once." />

                        <Grid Margin="0,14,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="End on" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="&#x2212;" Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="end-" Click="OnMacroNudge" />
                            <TextBlock Grid.Column="2" Text="{Binding EndOn}"
                                       Style="{StaticResource Mono}" FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="+" Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="end+" Click="OnMacroNudge" />
                            <TextBlock Grid.Column="4" Text="{Binding EndOnLabel}"
                                       Style="{StaticResource Subtle}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Visibility="{Binding IsMacro, Converter={StaticResource BoolToVisibility}}"
                        DataContext="{Binding Macro}">
                    <StackPanel>
                        <TextBlock Text="TIMING" Style="{StaticResource SectionLabel}" />

                        <Grid Margin="0,2,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Between clicks" VerticalAlignment="Center" Margin="0,5" />
                            <Button Grid.Column="1" Content="&#x2212;" Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="click-" Click="OnMacroNudge" />
                            <TextBlock Grid.Column="2" Text="{Binding ClickDelayMs}"
                                       Style="{StaticResource Mono}" FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="+" Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="click+" Click="OnMacroNudge" />
                            <TextBlock Grid.Column="4" Text="ms" Style="{StaticResource Subtle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="1" Text="Runs for"
                                       VerticalAlignment="Center" Margin="0,5" />
                            <Button Grid.Row="1" Grid.Column="1" Content="&#x2212;"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="duration-" Click="OnMacroNudge" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DurationMs}"
                                       Style="{StaticResource Mono}" FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="3" Content="+"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="duration+" Click="OnMacroNudge" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding DurationLabel}"
                                       Style="{StaticResource Subtle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="2" Text="Character screen"
                                       VerticalAlignment="Center" Margin="0,5" />
                            <Button Grid.Row="2" Grid.Column="1" Content="&#x2212;"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="open-" Click="OnMacroNudge" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding OpenDelayMs}"
                                       Style="{StaticResource Mono}" FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="3" Content="+"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="open+" Click="OnMacroNudge" />
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="ms after F1"
                                       Style="{StaticResource Subtle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="3" Text="Loadout page"
                                       VerticalAlignment="Center" Margin="0,5" />
                            <Button Grid.Row="3" Grid.Column="1" Content="&#x2212;"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="page-" Click="OnMacroNudge" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding PageDelayMs}"
                                       Style="{StaticResource Mono}" FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Row="3" Grid.Column="3" Content="+"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="page+" Click="OnMacroNudge" />
                            <TextBlock Grid.Row="3" Grid.Column="4" Text="ms after left arrow"
                                       Style="{StaticResource Subtle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="{Binding SwapEstimate}" Style="{StaticResource Subtle}"
                                   Foreground="{StaticResource TextBrush}" Margin="0,12,0,0" />

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                   Text="The two screen delays are really how long this machine takes to draw those screens. A click sent before the screen is there goes to whatever was underneath it." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Visibility="{Binding IsMacro, Converter={StaticResource BoolToVisibility}}"
                        DataContext="{Binding Macro}">
                    <StackPanel>
                        <TextBlock Text="WHILE IT RUNS" Style="{StaticResource SectionLabel}" />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,4"
                                  IsChecked="{Binding TickUplink, Mode=TwoWay}"
                                  Content="Hold 3074 uplink for the whole run" />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,10,0,4"
                                  IsChecked="{Binding DisableBuffer, Mode=TwoWay}"
                                  Content="Turn its buffer off for the whole run" />

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0"
                                   Text="Both are put back exactly as they were found when the run ends, however it ends - so a hold you started by hand stays held, and one the macro started does not." />
                    </StackPanel>
                </Border>

                <!-- What this module measures, which is not the same for all of them. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding MetricsLabel}"
                                   Style="{StaticResource SectionLabel}" />

                        <ItemsControl ItemsSource="{Binding Metrics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}" FontSize="19"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Label}"
                                                   Style="{StaticResource Subtle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TimerSettingsViewModel}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Timer" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0"
                                   Text="How long you have been in the current instance, worked out from 30k traffic. It starts when the game connects to a new server and stops when that server closes, or when the group falls silent." />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0"
                                   Text="Turning this off stops the watching entirely. To keep timing but hide it over the game, use Show the instance timer on the Overlay page instead." />
                    </StackPanel>

                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                              VerticalAlignment="Top" Margin="18,4,0,0"
                              IsChecked="{Binding IsEnabledSetting, Mode=TwoWay}"
                              Content="Enabled" />
                </Grid>

                <!-- The figure itself. The overlay is where this is read in practice, since the
                     game is what you are looking at; this is so it can be seen working, and so a
                     timer saying nothing can be told from one that is not running. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="NOW" Style="{StaticResource SectionLabel}" />

                        <TextBlock Text="{Binding Elapsed}" Style="{StaticResource Mono}"
                                   FontSize="40"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,2,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding State}" Style="{StaticResource Subtle}" />
                            <TextBlock Text="  ·  " Style="{StaticResource Subtle}"
                                       Visibility="{Binding Source, Converter={StaticResource EmptyToVisibility}}" />
                            <TextBlock Text="{Binding Source}" Style="{StaticResource Subtle}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Counts}" Style="{StaticResource Subtle}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="WAITS ON SILENCE" Style="{StaticResource SectionLabel}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Hide after" VerticalAlignment="Center" Margin="0,6" />
                            <Button Grid.Column="1" Content="−" Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="hide-" Click="OnTimerNudge" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding HideAfterS, StringFormat={}{0}s}" />
                            <Button Grid.Column="3" Content="+" Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="hide+" Click="OnTimerNudge" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Subtle}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"
                                       Text="{Binding HideInBeats}" />

                            <TextBlock Grid.Row="1" Text="Over after" VerticalAlignment="Center"
                                       Margin="0,6" />
                            <Button Grid.Row="1" Grid.Column="1" Content="−"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="end-" Click="OnTimerNudge" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Mono}"
                                       FontSize="14" Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding EndAfterS, StringFormat={}{0}s}" />
                            <Button Grid.Row="1" Grid.Column="3" Content="+"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="end+" Click="OnTimerNudge" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource Subtle}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"
                                       Text="{Binding EndInBeats}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,14,0,0"
                                   Text="{Binding Summary}" />

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0"
                                   Text="Seconds say how long you wait; heartbeats say how certain you are. 30k carries one every 3.02s, so a wait is really a count of how many have gone missing." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="HOW IT ENDS" Style="{StaticResource SectionLabel}" />
                        <TextBlock Style="{StaticResource Subtle}"
                                   Text="The server closing its connection ends it at once - that is what leaving an activity usually looks like. Not every departure does it, so the silence wait is the backstop." />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                   Text="A reconnect never ends it. That is a reset rather than a close, which is what makes the two possible to tell apart." />
                    </StackPanel>
                </Border>

                <!-- The API half. A correction, never a source: off or failing, the timer still
                     runs on traffic alone. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="ACCURATE START"
                                       Style="{StaticResource SectionLabel}" />

                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                      VerticalAlignment="Top"
                                      IsEnabled="{Binding IsEnabledSetting}"
                                      IsChecked="{Binding UseApi, Mode=TwoWay}"
                                      Content="Use the Bungie API" />
                        </Grid>

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0"
                                   Text="Traffic dates the instance from the connection, which is a second or two after the activity began - more after a loading screen. The server knows when it began, and nothing else does. This corrects the start and changes nothing else." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Bungie name" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Padding="10,7"
                                     Background="{StaticResource CardBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource LineBrush}"
                                     BorderThickness="1"
                                     IsEnabled="{Binding UseApi}"
                                     Text="{Binding BungieName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Grid.Row="1" Text="Key"
                                       VerticalAlignment="Center" Margin="0,12,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <TextBlock Text="{Binding KeyState}" Style="{StaticResource Mono}"
                                           VerticalAlignment="Center" />
                                <Button Content="Open folder" Style="{StaticResource FlatButton}"
                                        Margin="12,0,0,0" Padding="10,4" Click="OnOpenKeyFolder" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,14,0,0"
                                   Text="The key is a free one you make at bungie.net/developer, saved as bungie.key beside the config - not in it, so sharing the config never shares the key. Your name is the one other players see, Name#1234." />

                        <TextBlock Text="{Binding ApiState}" Style="{StaticResource Subtle}"
                                   Foreground="{StaticResource TextBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OverlaySettingsViewModel}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Overlay" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0"
                                   Text="A panel over the game saying what is held. It appears only while the game is the focused window, never takes a click and never takes focus." />
                    </StackPanel>

                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                              VerticalAlignment="Top" Margin="18,4,0,0"
                              IsChecked="{Binding IsEnabledSetting, Mode=TwoWay}"
                              Content="Enabled" />
                </Grid>

                <!-- Position. Drag the chip, or nudge the numbers - both end up as a corner and
                     two margins, so the overlay stays put when the game window resizes. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}">
                            <Run Text="POSITION" />
                            <Run Text="·" />
                            <Run Text="{Binding EditingLabel, Mode=OneWay}" />
                        </TextBlock>

                        <!-- Which chip the drag and the arrows move. Both panels are placed from
                             this one preview because the preview is the screen: two things that
                             appear on it, positioned from two separate pages, is how they end up
                             on top of each other with nowhere showing why. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton GroupName="PlacePanel" Style="{StaticResource Segment}"
                                         IsChecked="{Binding EditingModules, Mode=TwoWay}"
                                         Content="Modules" />
                            <RadioButton GroupName="PlacePanel" Style="{StaticResource Segment}"
                                         Margin="6,0,0,0"
                                         IsEnabled="{Binding TimerHasOwnPlace}"
                                         IsChecked="{Binding EditingTimer, Mode=TwoWay}"
                                         Content="Timer" />
                        </StackPanel>

                        <Border Background="{StaticResource WindowBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="6"
                                HorizontalAlignment="Left" Padding="1">
                            <Canvas Width="384" Height="216"
                                    Background="Transparent"
                                    Loaded="OnPreviewLoaded"
                                    MouseLeftButtonDown="OnPreviewDown"
                                    MouseMove="OnPreviewMove"
                                    MouseLeftButtonUp="OnPreviewUp">
                                <!-- Tagged, because the code behind places each from its own
                                     corner and margins and drags whichever is selected. -->
                                <Border Tag="Modules" Width="64" Height="18" CornerRadius="3"
                                        Background="{StaticResource AccentBrush}"
                                        Opacity="{Binding EditingModules,
                                                  Converter={StaticResource BoolToOpacity}}"
                                        Canvas.Left="0" Canvas.Top="0">
                                    <TextBlock Text="modules" FontSize="9" Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- The same accent as the module chip, because it is the same
                                     kind of thing in the same preview. Red here would read as a
                                     module holding, which is what that colour means everywhere
                                     else in this window. Which one is selected is the opacity. -->
                                <Border Tag="Timer" Width="44" Height="18" CornerRadius="3"
                                        Background="{StaticResource AccentBrush}"
                                        Opacity="{Binding EditingTimer,
                                                  Converter={StaticResource BoolToOpacity}}"
                                        Visibility="{Binding TimerHasOwnPlace,
                                                     Converter={StaticResource BoolToVisibility}}"
                                        Canvas.Left="0" Canvas.Top="0">
                                    <TextBlock Text="0:00" FontSize="9" Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Canvas>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding CornerLabel}" Style="{StaticResource Subtle}" />
                            <TextBlock Text="   ·   drag the chip, or use the arrows"
                                       Style="{StaticResource Subtle}" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="X" VerticalAlignment="Center" Margin="0,5" />
                            <Button Grid.Column="1" Content="−" Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="x-" Click="OnNudge" />
                            <TextBlock Grid.Column="2" Text="{Binding MarginX}"
                                       Style="{StaticResource Mono}" FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="+" Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="x+" Click="OnNudge" />
                            <TextBlock Grid.Column="4" Text="px" Style="{StaticResource Subtle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="1" Text="Y" VerticalAlignment="Center" Margin="0,5" />
                            <Button Grid.Row="1" Grid.Column="1" Content="−"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="y-" Click="OnNudge" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MarginY}"
                                       Style="{StaticResource Mono}" FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="3" Content="+"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,3" Padding="12,4" Tag="y+" Click="OnNudge" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="px"
                                       Style="{StaticResource Subtle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,12,0,0"
                                   Text="Distance from the anchored corner, in pixels of a 1920x1080 window. The preview is that window to scale." />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,14,0,0"
                                  IsChecked="{Binding ShowTimerPanel, Mode=TwoWay}"
                                  Content="Show the instance timer" />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,10,0,0"
                                  IsEnabled="{Binding ShowTimerPanel}"
                                  IsChecked="{Binding TimerAttached, Mode=TwoWay}"
                                  Content="Keep it in the module panel" />

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                   Text="Attached, the timer is the top row of the module panel and shares its corner. Detached, it is a panel of its own with its own place on the screen." />
                    </StackPanel>
                </Border>

                <!-- Appearance, for whichever panel the selector above is on. A timer you want
                     large and a module list you want out of the way are different wants. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}">
                            <Run Text="APPEARANCE" />
                            <Run Text="·" />
                            <Run Text="{Binding EditingLabel, Mode=OneWay}" />
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,6" />
                            <Slider Grid.Column="1" VerticalAlignment="Center"
                                    Minimum="0.5" Maximum="3" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Scale, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding Scale, StringFormat={}{0:0.0}x}"
                                       Style="{StaticResource Mono}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Text="Background" VerticalAlignment="Center"
                                       Margin="0,6" />
                            <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                    Minimum="0" Maximum="1" TickFrequency="0.02"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Opacity, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Text="{Binding Opacity, StringFormat={}{0:P0}}"
                                       Style="{StaticResource Mono}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- What it lists. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CONTENT" Style="{StaticResource SectionLabel}" />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,4"
                                  IsChecked="{Binding ShowTimers, Mode=TwoWay}"
                                  Content="Show how long each one has been held" />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,10,0,4"
                                  IsChecked="{Binding ShowIdle, Mode=TwoWay}"
                                  Content="Also list modules that are not held" />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,10,0,4"
                                  IsChecked="{Binding HideWhenIdle, Mode=TwoWay}"
                                  Content="Disappear entirely when nothing is held" />
                    </StackPanel>
                </Border>

                <!-- Which window it follows. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FOLLOWS" Style="{StaticResource SectionLabel}" />

                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="190" Padding="10,7"
                                     Background="{StaticResource CardBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     CaretBrush="{StaticResource TextBrush}"
                                     BorderThickness="0"
                                     FontFamily="{StaticResource MonoFont}"
                                     Text="{Binding Process, Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text=".exe" Style="{StaticResource Subtle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,12,0,0"
                                   Text="The overlay is shown only while this process owns the foreground window. It cannot draw over exclusive fullscreen - nothing outside the game can - so use borderless windowed." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Title bar ============ -->
            <Border Grid.Row="0" Grid.ColumnSpan="3"
                    Background="{StaticResource RailBrush}"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource AccentBrush}" />
                        <TextBlock Text="d2vpn" Margin="10,0,0,0" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Click="OnMinimise"
                                ToolTip="Minimise">
                            <Path Data="M 0,0 H 10" Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1" />
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="OnMaximise"
                                ToolTip="Maximise">
                            <Path Data="M 0,0 H 10 V 10 H 0 Z" Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1" Fill="Transparent" />
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="OnClose"
                                ToolTip="Close">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{StaticResource TextBrush}" StrokeThickness="1" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Rail ============ -->
            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                    Background="{StaticResource RailBrush}">
                <ListBox Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource RailItem}"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding Category, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="64">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{Binding Icon, Converter={StaticResource KeyToGeometry}}"
                                          Stroke="{Binding RelativeSource={RelativeSource
                                             AncestorType=ListBoxItem}, Path=Foreground}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="10"
                                               Margin="0,6,0,0" HorizontalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource
                                                  AncestorType=ListBoxItem}, Path=Foreground}" />
                                </StackPanel>

                                <!-- Something in this section is on, even though you are looking
                                     at another one. -->
                                <Ellipse Width="6" Height="6" Margin="0,8,12,0"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Fill="{StaticResource HoldingBrush}"
                                         Visibility="{Binding HasActive,
                                            Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ============ Sidebar ============ -->
            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Category.Name}"
                               Style="{StaticResource SectionLabel}"
                               Margin="18,18,18,6" />

                    <TextBlock Grid.Row="1" Style="{StaticResource Subtle}"
                               Margin="18,8,18,0"
                               Text="{Binding Category.EmptyMessage}"
                               Visibility="{Binding Category.IsEmpty,
                                  Converter={StaticResource BoolToVisibility}}" />

                    <ListBox x:Name="ModuleList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             ItemsSource="{Binding Category.Items}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Opacity="{Binding IsEnabled,
                                                   Converter={StaticResource BoolToOpacity}}">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SidebarDetail}"
                                                   FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource Mono}">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource TextFaintBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTiming}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource HoldingBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- The only red in the sidebar, so a module that is holding is
                                         visible without reading anything. -->
                                    <Ellipse Grid.Column="1" Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource HoldingBrush}"
                                             Visibility="{Binding IsActive,
                                                Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>

            <!-- ============ Empty state ============ -->
            <StackPanel Grid.Row="1" Grid.Column="2"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="440"
                        Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="Nothing is hosted" Style="{StaticResource Heading}"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Subtle}" TextAlignment="Center" Margin="0,10,0,0"
                           Text="No module could be started. The footer says why - the usual causes are another limiter still running, or this process not being elevated." />
                <TextBlock Style="{StaticResource Subtle}" TextAlignment="Center" Margin="0,14,0,0"
                           Text="{Binding ConfigPath, StringFormat=config: {0}}" />
            </StackPanel>

            <!-- ============ Detail ============ -->
            <!--
                A ContentControl rather than a panel, so the layout is chosen from the runtime type
                of whatever is selected. A module and a settings page are different enough that one
                template with everything hidden half the time would be worse than two.
            -->
            <ScrollViewer Grid.Row="1" Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          Padding="26,20,26,8"
                          Visibility="{Binding Selected,
                             Converter={StaticResource NotNullToVisibility}}">
                <ContentControl Content="{Binding Selected}" />
            </ScrollViewer>

            <!-- ============ Status bar ============ -->
            <Border Grid.Row="2" Grid.Column="2"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Confirmations and failures land here rather than beside the title, where
                         "saved" sat permanently next to the name of the application. -->
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Mono}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="6,0,12,0" />

                    <Button Grid.Column="1" Content="Release all"
                            Style="{StaticResource QuietButton}"
                            Click="OnReleaseAll" />

                    <TextBlock Grid.Column="2" Style="{StaticResource Mono}"
                               VerticalAlignment="Center" Margin="16,0,6,0">
                        <Run Text="holding " />
                        <Run Text="{Binding ActiveCount, Mode=OneWay}"
                             Foreground="{StaticResource HoldingBrush}" FontWeight="Bold" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
