<Window x:Class="D2Vpn.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="d2vpn"
        Height="640" Width="980"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="18,20,18,16">
                    <TextBlock Text="d2vpn" Style="{StaticResource Heading}" />
                    <TextBlock Text="traffic control for Destiny 2"
                               Style="{StaticResource Subtle}" Margin="0,2,0,0" />
                </StackPanel>

                <ListBox x:Name="ModuleList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding BindLabel}"
                                               Style="{StaticResource Mono}"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               FontSize="11" />
                                </StackPanel>

                                <!-- A filled dot means holding. It is the only red in the sidebar,
                                     so an active module is visible without reading anything. -->
                                <Ellipse Grid.Column="1" Width="8" Height="8"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource HoldingBrush}"
                                         Visibility="{Binding IsActive,
                                            Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" Content="Release everything"
                        Style="{StaticResource DangerButton}"
                        Margin="14,10,14,16"
                        Click="OnReleaseAll" />
            </Grid>
        </Border>

        <!-- ============ Detail ============ -->
        <!-- Empty state. Without this the detail cards render against a null selection, which
             reads as a working panel whose every value happens to be blank. -->
        <StackPanel Grid.Column="1" Grid.Row="0"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="440"
                    Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="Nothing is hosted" Style="{StaticResource Heading}"
                       HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Subtle}" TextAlignment="Center" Margin="0,10,0,0"
                       Text="No module could be started. The status bar below says why - the usual causes are another limiter still running, or this process not being elevated." />
            <TextBlock Style="{StaticResource Subtle}" TextAlignment="Center" Margin="0,14,0,0"
                       Text="{Binding ConfigPath, StringFormat=config: {0}}" />
        </StackPanel>

        <ScrollViewer Grid.Column="1" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="26,22,26,8"
                      Visibility="{Binding Selected, Converter={StaticResource NotNullToVisibility}}">
            <StackPanel DataContext="{Binding Selected}">

                <!-- Header: name, state, and the hold switch. -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Subtle}" />
                            <TextBlock Text="  ·  " Style="{StaticResource Subtle}" />
                            <TextBlock Text="{Binding StateLabel}"
                                       Style="{StaticResource Subtle}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource Switch}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                              Content="Hold" />
                </Grid>

                <!-- Keys. Click a box, press a key; Esc clears it. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="KEYS" Style="{StaticResource SectionLabel}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Hold" VerticalAlignment="Center" Margin="0,6" />
                            <Button Grid.Column="1" Margin="0,4"
                                    Style="{StaticResource FlatButton}"
                                    HorizontalContentAlignment="Left"
                                    Content="{Binding BindLabel}"
                                    Tag="Toggle"
                                    Click="OnRebind" />

                            <TextBlock Grid.Row="1" Text="Autoresync"
                                       VerticalAlignment="Center" Margin="0,6"
                                       Visibility="{Binding SupportsResync,
                                          Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Row="1" Grid.Column="1" Margin="0,4"
                                    Style="{StaticResource FlatButton}"
                                    HorizontalContentAlignment="Left"
                                    Content="{Binding ResyncKeyLabel}"
                                    Tag="Resync"
                                    Click="OnRebind"
                                    Visibility="{Binding SupportsResync,
                                       Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Row="2" Text="Buffer"
                                       VerticalAlignment="Center" Margin="0,6"
                                       Visibility="{Binding SupportsBuffer,
                                          Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Row="2" Grid.Column="1" Margin="0,4"
                                    Style="{StaticResource FlatButton}"
                                    HorizontalContentAlignment="Left"
                                    Content="{Binding BufferKeyLabel}"
                                    Tag="Buffer"
                                    Click="OnRebind"
                                    Visibility="{Binding SupportsBuffer,
                                       Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0"
                                   Text="Click a key, then press one. Esc clears it, so a module can be driven from the window alone." />
                    </StackPanel>
                </Border>

                <!-- Switches. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasSwitches,
                           Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="SWITCHES" Style="{StaticResource SectionLabel}" />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,4"
                                  IsChecked="{Binding ResyncEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding SupportsResync}"
                                  Content="Autoresync"
                                  Visibility="{Binding SupportsResync,
                                     Converter={StaticResource BoolToVisibility}}" />

                        <CheckBox Style="{StaticResource Switch}" Margin="0,8,0,4"
                                  IsChecked="{Binding BufferEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding SupportsBuffer}"
                                  Content="Buffer withheld packets"
                                  Visibility="{Binding SupportsBuffer,
                                     Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0"
                                   Text="Both take effect on the next packet. A delay line cannot give up its buffer, since a packet cannot arrive late unless it was kept." />
                    </StackPanel>
                </Border>

                <!-- Counters. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TRAFFIC" Style="{StaticResource SectionLabel}" />

                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Seen}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="seen" Style="{StaticResource Subtle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Dropped}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="withheld" Style="{StaticResource Subtle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Buffered}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="buffered" Style="{StaticResource Subtle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Replayed}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="replayed" Style="{StaticResource Subtle}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Reconnect, only where it exists. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding SupportsReset,
                           Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="RECONNECT" Style="{StaticResource SectionLabel}" />
                        <TextBlock Style="{StaticResource Subtle}"
                                   Text="Injects a TCP reset into every live connection on this group. The game error-codes and reconnects by itself." />
                        <Button Content="Reconnect now"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Click="OnReset" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ Status bar ============ -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="26,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Status}" Style="{StaticResource Mono}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Style="{StaticResource Mono}"
                           VerticalAlignment="Center">
                    <Run Text="holding " />
                    <Run Text="{Binding ActiveCount, Mode=OneWay}"
                         Foreground="{StaticResource HoldingBrush}" FontWeight="Bold" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
