# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# Packet captures.
# These hold real traffic: peer IP addresses, server addresses, and the local addresses
# assigned by the VPN. None of it belongs in a public repository. Findings derived from
# captures live in docs/ instead, which is the part worth publishing.
captures/
*.pcapng
*.pcap
*.sockets

# Session logs from individual runs. The ones worth keeping as evidence live at the
# repo root; this folder is scratch for the current run.
logs/

# The working config. It is personal - your keybinds, and possibly a process name or a
# path - and it is regenerated any time with `d2vpn config init`. The template that
# produces it is ConfigTemplate in the Core project, which is what belongs in the repo.
d2vpn.json

# The Bungie API key. It lives in %APPDATA% and never needs to be here, but a copy made for
# testing would otherwise be one 'git add -A' from being published.
bungie.key
*.key
